# SPOKES Goal Setting Server — Environment Variables
# Copy this file to .env and fill in your values.

# JWT signing secret (REQUIRED in production — must not be the default)
SPOKES_TOKEN_SECRET=replace-with-a-long-random-secret

# Teacher/instructor API access key (REQUIRED in production — must not be the default)
SPOKES_TEACHER_KEY=replace-with-a-strong-teacher-key

# Server host and port
# HOST=0.0.0.0
# PORT=8787

# Live classroom data (FERPA quarantine). Default in server.js already points here.
# SPOKES_DATA_FILE=../_student-records/SPOKES Goal Setting Project/data/student-goals.json
# E2E uses data/student-goals.e2e.json via playwright.config.cjs — do not override for tests.

# Set to "production" to enforce secure defaults
# NODE_ENV=production

# CORS allowed origins (comma-separated). Leave empty to allow all (dev only).
# Example: https://spokes-goal-setting.onrender.com,http://localhost:8787
# SPOKES_ALLOWED_ORIGINS=

# Google OAuth (optional — leave blank to disable)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_ALLOWED_DOMAIN=

# AI Coach (local Ollama)
# Set to false to disable AI routes and UI integrations.
# SPOKES_AI_ENABLED=true
# SPOKES_AI_PROVIDER=ollama
# SPOKES_AI_OLLAMA_URL=http://127.0.0.1:11434
# SPOKES_AI_MODEL=glm-4.7-flash
# SPOKES_AI_TIMEOUT_MS=12000
# SPOKES_AI_MAX_INPUT_CHARS=1200
# SPOKES_AI_MAX_HISTORY_TURNS=6
# SPOKES_AI_MAX_CONCURRENT=3
# SPOKES_AI_RATE_PER_MINUTE=12

# Render deployment key (if using Render)
# RENDER_API_KEY=
